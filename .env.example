# Copy to .env in the repository root; the inference and evaluation scripts load it with
# python-dotenv. Never commit .env. Every entry is optional unless noted.

# Hugging Face cache location (SVD and CLIP weights are downloaded there)
# HF_HOME=/path/to/huggingface/cache

# Keep Weights & Biases logging local
# WANDB_MODE=offline

# Required by scripts/llm_judge_controllability.py and scripts/llm_judge_controllability_pairwise.py
# ANTHROPIC_API_KEY=
# Only needed when the API key is not scoped to a workspace
# ANTHROPIC_WORKSPACE_ID=

# Optional start/finish notifications from inference and latent extraction
# DISCORD_WEBHOOK_URL=
